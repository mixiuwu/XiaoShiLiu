# 生产环境配置模板：部署时复制为 express-project/.env.production 并填写真实值
NODE_ENV=production
PORT=3001

# JWT（务必替换为随机长字符串）
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# 数据库（沿用现有远程 MySQL）
DB_HOST=119.3.222.254
DB_PORT=3306
DB_USER=REPLACE_DB_USER
DB_PASSWORD=REPLACE_DB_PASSWORD
DB_NAME=REPLACE_DB_NAME

# 对外地址（用于生成上传文件 URL，必须是带 https 的域名）
API_BASE_URL=https://REPLACE_DOMAIN
LOCAL_BASE_URL=https://REPLACE_DOMAIN

# 允许跨域的前端来源（多个用逗号分隔）
CORS_ORIGIN=https://REPLACE_DOMAIN

# 上传配置
IMAGE_MAX_SIZE=10mb
VIDEO_MAX_SIZE=100mb
IMAGE_UPLOAD_STRATEGY=imagehost
VIDEO_UPLOAD_STRATEGY=local
LOCAL_UPLOAD_DIR=uploads
IMAGE_LOCAL_UPLOAD_DIR=uploads/images
VIDEO_LOCAL_UPLOAD_DIR=uploads/videos
IMAGEHOST_API_URL=https://api.xinyew.cn/api/360tc
IMAGEHOST_TIMEOUT=60000

# 邮件服务（可选）
EMAIL_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE_SMTP_USER
SMTP_PASSWORD=REPLACE_SMTP_PASSWORD
EMAIL_FROM=REPLACE_SMTP_USER
EMAIL_FROM_NAME=小石榴校园图文社区

# IP 属地
IP_LOCATION_PRIMARY_API=https://api.pearktrue.cn/api/ip/details
IP_LOCATION_PRIMARY_TIMEOUT=10000
IP_LOCATION_BACKUP_API=https://api.pearktrue.cn/api/ip/high
IP_LOCATION_BACKUP_TIMEOUT=5000
